// [MODIFY] Kernel 类 - 封装 NPU 上的计算逻辑
class KernelAbs {
public:
    __aicore__ inline KernelAbs(AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
    };

    // [MODIFY] 根据你的算子修改 Init 参数和 Global Tensor
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
                                const __gm__ AbsTilingData* tiling)
    {
        this->tiling = tiling;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx < tiling->blockNum - 1) {
            total = tiling->numPerCore;
            tileNum = total / TILE_LENGTH;
            tailTileElementNum = TILE_LENGTH;
        } else {
            total = tiling->tailNumLastCore;
            tileNum = (total + (TILE_LENGTH - 1))/ TILE_LENGTH;
            tailTileElementNum = total - TILE_LENGTH * (tileNum - 1);
        }

        // [MODIFY] 根据你的输入/输出数量调整 Global Tensor
        xGm.SetGlobalBuffer((__gm__ half *)x + blockIdx * tiling->numPerCore, total);
        yGm.SetGlobalBuffer((__gm__ half *)y + blockIdx * tiling->numPerCore, total);

        // [MODIFY] 根据你的算子计算逻辑，调整UB Buffer初始化
        pipe_->InitBuffer(inQueueX, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(outQueue, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t count = (i == tileNum - 1) ? tailTileElementNum : TILE_LENGTH;
            CopyIn(count);
            Compute(count);
            CopyOut(count);
        }
    }

    __aicore__ inline void CopyIn(uint32_t count)
    {
        AscendC::LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();

        AscendC::DataCopyPad(xLocal, xGm,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0},
            {false, 0, 0, 0});

        inQueueX.EnQue(xLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<half> xLocal = inQueueX.DeQue<half>();
        AscendC::LocalTensor<half> yLocal = outQueue.AllocTensor<half>();

        // [MODIFY] 替换为你的计算逻辑
        AscendC::Abs(yLocal, xLocal, count);

        outQueue.EnQue<half>(yLocal);
        inQueueX.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint32_t count)
    {
        AscendC::LocalTensor<half> yLocal = outQueue.DeQue<half>();
        AscendC::DataCopyPad(yGm, yLocal,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0});
        outQueue.FreeTensor(yLocal);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ AbsTilingData* tiling;

    // [MODIFY] 根据你的输入/输出数量调整
    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> yGm;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;

    uint32_t total;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

// [MODIFY] 核函数入口 - abs_custom → <your_op>（保持 _kernel 后缀）
extern "C" __global__ __vector__ void abs_custom_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR tiling)
{
